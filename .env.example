DEEPINSIGHT_API_KEY=
DEEPINSIGHT_API_BASE=https://api.deepseek.com
DEEPINSIGHT_MODEL_NAME=deepseek-reasoner
DEEPINSIGHT_RECOMMENDATION_API_KEY=

# Runtime mode: "local" (direct LangGraph), "api" (FastAPI only), "auto" (API with local fallback)
DEEPINSIGHT_QUERY_RUNTIME=local
DEEPINSIGHT_API_SERVER_URL=http://127.0.0.1:8000
DEEPINSIGHT_USE_CHROMA_RAG=false
DEEPINSIGHT_LLM_TIMEOUT=120

# LangSmith tracing (set LANGCHAIN_TRACING_V2=true to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=deepinsight

# MySQL credentials (for production DB; SQLite uses no password)
# DEEPINSIGHT_DB_PASSWORD=your_password_here
DEEPINSIGHT_NORTHWIND_DB_URI=mysql+pymysql://root@localhost:3306/northwind
DEEPINSIGHT_ADVENTUREWORKS_DB_URI=mysql+pymysql://root@localhost:3306/adventureworks
